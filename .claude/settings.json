{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run bankrag search:*)",
      "Bash(uv run bankrag ingest:*)",
      "Bash(uv run python evals/run_evals.py)",
      "Bash(uv run python scripts/download.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python_style_read.py\"",
            "timeout": 15,
            "statusMessage": "Checking python-style.md was read..."
          }
        ]
      }
    ]
  }
}
